{
    "name": "request-tax",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "benchmark": "node harness/index.js",
        "phase:a": "node harness/index.js --phase a",
        "phase:b": "node harness/index.js --phase b",
        "phase:c": "node harness/index.js --phase c",
        "run:all": "node harness/sequencer.js",
        "smoke:a": "node harness/index.js --phase a --smoke",
        "smoke:b": "node harness/index.js --phase b --smoke",
        "smoke:c": "node harness/index.js --phase c --smoke",
        "smoke:all": "node harness/sequencer.js --smoke",
        "quick:a": "node harness/index.js --phase a --measured-runs 10 --warmup-runs 1",
        "quick:b": "node harness/index.js --phase b --measured-runs 10 --warmup-runs 1",
        "quick:c": "node harness/index.js --phase c --measured-runs 10 --warmup-runs 1",
        "quick:all": "node harness/sequencer.js --measured-runs 10 --warmup-runs 1",
        "verify:h3": "node scripts/verify-h3.mjs",
        "analyze:extract": "node harness/analysis/extract-runs.js",
        "analyze:compare": "node harness/analysis/compare.js",
        "analyze:charts": "node harness/analysis/chart-specs.js",
        "analyze": "pnpm analyze:extract && pnpm analyze:compare && pnpm analyze:charts",
        "report": "node harness/report/build-report.js",
        "report:open": "node harness/report/build-report.js --open",
        "postinstall": "playwright install chromium"
    },
    "dependencies": {
        "minimist": "^1.2.8",
        "playwright": "^1.53.0"
    }
}