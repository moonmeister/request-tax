{
    auto_https disable_redirects

    # Port 8443 is reserved for HTTP/1.1-only benchmark runs.
    servers :8443 {
        protocols h1
    }

    # Port 8444 is reserved for HTTP/3-only benchmark runs.
    servers :8444 {
        protocols h3
    }
}

https://localhost:8443 {
    tls internal

    header {
        -Alt-Svc
    }

    # Phase B cache testing on the HTTP/1.1-only listener.
    @payload path /payload/*
    handle @payload {
        cache
        reverse_proxy origin:3000
    }

    reverse_proxy origin:3000
}

https://localhost:8444 {
    tls internal

    # Phase B and Phase C cache testing on the HTTP/3-only listener.
    @payload path /payload/*
    handle @payload {
        cache
        reverse_proxy origin:3000
    }

    reverse_proxy origin:3000
}
